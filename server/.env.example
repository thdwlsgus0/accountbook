PORT=4000

# localhost는 환경에 따라 IPv6(::1)로 해석되어 MySQL 연결이 거부될 수 있으므로 127.0.0.1을 쓴다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=accountbook

# 로그인 토큰 서명에 쓰이는 비밀 값. 실제 값으로 반드시 바꿔서 사용하세요.
JWT_SECRET=change-this-to-a-long-random-string

# 네이버 로그인 state 쿠키에 Secure 플래그를 붙일지 여부.
# 로컬/HTTP 배포에서는 false, 도메인+HTTPS를 붙인 뒤에는 true로 바꾼다.
COOKIE_SECURE=false

# 네이버 로그인 (https://developers.naver.com/apps 에서 애플리케이션을 등록해 발급)
# NAVER_CALLBACK_URL은 네이버 개발자센터에 등록한 Callback URL과 정확히 같아야 한다.
# 개발 환경에서는 Vite 프록시를 거치도록 5173 포트 주소를 쓴다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_CALLBACK_URL=http://localhost:5173/api/auth/naver/callback

# 로그인 완료 후 돌아갈 프론트엔드 주소
CLIENT_URL=http://localhost:5173
