# docker-compose가 사용하는 프로덕션 환경변수 파일.
# 서버(VPS)에서 이 파일을 복사해 실제 값을 채운 뒤 파일명을 .env로 저장하세요.
#   cp .env.production.example .env
# 이 .env는 저장소 안의 server/.env(로컬 개발용)와는 별개의, 리포지토리 루트 파일입니다.

# --- MySQL ---
DB_NAME=accountbook
DB_ROOT_PASSWORD=change-this-strong-password

# --- 서버 ---
# 아무 문자열이나 추측 불가능하게. 예: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string
# 도메인 없이 IP로 배포하는 동안은 false. 나중에 HTTPS를 붙이면 true로 바꾸세요.
COOKIE_SECURE=false

# --- 네이버 로그인 (https://developers.naver.com/apps) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 아래 두 값의 <서버_공인_IP>를 실제 IP로 바꾸세요. 예: http://123.45.67.89/api/auth/naver/callback
# NAVER_CALLBACK_URL은 네이버 개발자센터에 등록한 Callback URL과 정확히 같아야 합니다.
NAVER_CALLBACK_URL=http://<서버_공인_IP>/api/auth/naver/callback
CLIENT_URL=http://<서버_공인_IP>
